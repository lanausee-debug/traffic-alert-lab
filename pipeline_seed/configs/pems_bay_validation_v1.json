{
  "protocol_id": "pems-bay-alert-validation-v1",
  "created_date": "2026-10-10",
  "status": "plan_only_not_executed",
  "dataset": {
    "name": "PEMS-BAY",
    "source": "https://github.com/liyaguang/DCRNN#data-preparation",
    "local_path": "data/raw/pems-bay.h5",
    "timestamp_source": "actual_hdf5_metadata",
    "interval_minutes": 5,
    "minimum_calendar_days": 126,
    "station_count": 24,
    "station_selection": "smallest_sha256_of_salt_pipe_utf8_string_id_then_lexical_id_order",
    "station_selection_salt": "traffic-alert-pems-bay-24-v1",
    "station_id_canonicalization": "str(id).strip(); reject empty or duplicate canonical ids",
    "selection_uses_traffic_values": false,
    "training_availability_floor": 0.95,
    "quality_failure_action": "report_infeasible_do_not_replace_stations",
    "natural_validity": "finite_and_strictly_positive",
    "speed_unit": "mph_verify_at_data_binding"
  },
  "partitions_days_half_open": {
    "forecast_train": [0, 42],
    "forecast_validation": [42, 49],
    "risk_train": [49, 77],
    "risk_validation": [77, 84],
    "calibration": [84, 98],
    "evaluation": [98, null]
  },
  "day_zero": "midnight_of_first_timestamp_in_file_native_time_axis",
  "cross_partition_windows": false,
  "evaluation_value_access_before_selection_freeze": false,
  "scenarios": ["natural", "single_outage", "group_outage"],
  "outages": {
    "single": "calendar_day_index_mod_24_station_hidden_for_entire_day",
    "group": "calendar_day_index_mod_12_selects_group_hidden_for_entire_day",
    "groups": "first_12_selected_ids_as_centers_each_with_two_highest_training_correlation_neighbors_ties_lexical_id",
    "historical_fault_observations_restored": false,
    "changes_event_truth_or_denominator": false,
    "spatial_contiguity_claim": false
  },
  "forecaster": {
    "class": "fresh_holdout_pilot.MaskedGraphTCN",
    "history_steps": 12,
    "horizon_steps": 3,
    "channels": 32,
    "gated_dilations": [1, 2, 4],
    "node_embedding_dimension": 8,
    "dropout": 0.05,
    "seeds": [42, 43, 44],
    "epochs": 25,
    "batch_size": 128,
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "loss": "naturally_valid_target_normalized_masked_L1",
    "gradient_clip_norm": 5.0,
    "selection": "minimum_masked_validation_MAE_mph_ties_earlier_epoch",
    "normalization_source": "forecast_train_only",
    "graph": "training_normalized_zero_filled_positive_correlation_top4_plus_self_row_normalized",
    "graph_is_geographic": false,
    "augmentation": {
      "station_suffix_probability": 0.30,
      "suffix_length_uniform_inclusive": [0, 12],
      "point_dropout_probability": 0.03,
      "training_mask_seed_offset": 100,
      "shuffle_seed_offset": 200,
      "validation_mask_seed": 991
    },
    "new_network_retrained": true,
    "ensemble": "arithmetic_mean_of_all_three_selected_seeds"
  },
  "risk": {
    "features": "congestion_risk_pilot.features",
    "feature_dimension": 51,
    "sample_stride_steps": 1,
    "shared_supervision_validity": "natural_readings_t_minus_1_through_t_plus_4_valid_and_history_to_t_plus_4_continuous_inside_partition",
    "persistent_target": "Y(t)=all_three_raw_speeds_t_through_t_plus_2_at_most_30_mph",
    "onset_target": "E(s)=Y(s)_and_not_Y(s_minus_1); Z(t)=E(t)_or_E(t_plus_1)_or_E(t_plus_2)",
    "normalization_source": "risk_train_common_valid_pool_across_three_scenarios_only",
    "mlp_hidden_dimensions": [32, 16],
    "mlp_activation": "ReLU",
    "mlp_seeds": [202, 203, 204],
    "mlp_optimizer": "Adam",
    "mlp_learning_rate": 0.001,
    "mlp_weight_decay": 0.001,
    "mlp_updates": 1350,
    "mlp_batch_size": 4096,
    "mlp_sampling": "uniform_with_replacement_no_class_weights",
    "mlp_checkpoints": [225, 450, 900, 1350],
    "mlp_selection": "own_target_unweighted_validation_BCE_ties_earlier_checkpoint",
    "linear_solver": "congestion_solver_audit.fit_linear",
    "linear_l2_grid": [0.0001, 0.001, 0.01],
    "linear_max_selected_gradient": 0.0001,
    "grouped_calibration": "own_12_step_history_count_0_partial_or_12",
    "group_fallback": "global_if_train_rows_less_than_100_or_train_one_class_or_validation_empty"
  },
  "methods": [
    {"id": "dense_speed", "input": "ensemble_three_future_speed_max", "target": null},
    {"id": "global_calibration", "input": "negative_ensemble_future_speed_max_div_70", "target": "persistent"},
    {"id": "group_calibration", "input": "negative_ensemble_future_speed_max_div_70", "target": "persistent"},
    {"id": "state_logistic", "input": "51_state_features", "target": "persistent"},
    {"id": "persistent_mlp", "input": "51_state_features", "target": "persistent"},
    {"id": "onset_linear", "input": "51_state_features", "target": "onset"},
    {"id": "onset_mlp", "input": "51_state_features", "target": "onset"}
  ],
  "calibration": {
    "budget_source": "each_scenario_calibration_dense_speed_30_mph_confirmation_1_false_per_valid_station_day",
    "budget_relaxation": 0,
    "comparison_epsilon": 1e-12,
    "shared_setting_across_scenarios": true,
    "confirmations": [1, 2],
    "probability_fine": {"start": 0.01, "stop_inclusive": 0.9, "step": 0.005, "off": 1.0001},
    "probability_coarse": [0.01, 0.02, 0.03, 0.05, 0.075, 0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50, 0.60, 0.70, 0.80, 0.90, 1.0001],
    "speed_fine_mph": {"start": 15, "stop_inclusive": 60, "step": 0.5},
    "speed_coarse_mph": {"start": 15, "stop_inclusive": 60, "step": 2.5},
    "speed_score": "negative_ensemble_future_speed_max",
    "speed_off_score_threshold": 1000,
    "rank_minimize": ["negative_mean_all_warning_recall", "negative_minimum_scenario_all_warning_recall", "mean_false_rate", "confirmation", "declared_grid_index"],
    "search": "full_enumeration_not_binary_search"
  },
  "evaluation": {
    "event_definition": "congestion_alert_pilot.event_stats_with_congestion_density_pilot.evaluate_with_leads",
    "complete_event_validity": "original_three_natural_target_readings_not_six_reading_supervision_mask",
    "primary_metric": "fraction_complete_proxy_events_warned_10_or_15_minutes_by_existing_scoring_formula",
    "candidate": "onset_mlp_fine",
    "primary_references": ["global_calibration_fine", "group_calibration_fine"],
    "primary_family_size": 2,
    "bootstrap": "paired_calendar_dates_across_all_methods_and_scenarios_resample_counts_then_recompute_rates",
    "bootstrap_rounds": 2000,
    "bootstrap_seed": 8120,
    "primary_interval_confidence": 0.975,
    "descriptive_interval_confidence": 0.95,
    "aggregation": "equal_mean_of_three_scenario_rates",
    "training_uncertainty_in_intervals": false,
    "primary_success": "both_primary_long_warning_delta_intervals_have_lower_bound_strictly_positive",
    "overall_service_improvement": "not_inferred_from_primary_success_or_intervals_containing_zero",
    "secondary_comparisons": ["onset_mlp_fine_minus_persistent_mlp_fine", "onset_mlp_fine_minus_onset_linear_fine", "every_method_fine_minus_its_coarse"],
    "report_all_methods_and_scenarios": true,
    "evaluation_grid_scan": false,
    "infeasibility": "zero_complete_calibration_or_evaluation_events_or_zero_exposure_report_without_retuning"
  },
  "release": {
    "github_published": false,
